{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    { "source": "/ty", "destination": "/api/ty" }
  ],
  "functions": {
    "api/refresh.js": { "maxDuration": 300, "includeFiles": "public/features/**" },
    "api/calls.js": { "maxDuration": 300, "includeFiles": "public/features/**" },
    "api/ingest.js": { "maxDuration": 300, "includeFiles": "public/features/**" },
    "api/integrations.js": { "maxDuration": 120, "includeFiles": "public/features/**" },
    "api/paylinks.js": { "maxDuration": 60, "includeFiles": "public/features/**" },
    "api/ty.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
